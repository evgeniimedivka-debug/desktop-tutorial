{
  "name": "CF-08 Публикация в Telegram по одобрению (NocoDB)",
  "nodes": [
    {
      "id": "webhook01",
      "name": "Webhook: NocoDB approve",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "cf/publish-telegram",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "7a5b37c5-adc4-4615-8222-70073b9dbe2a"
    },
    {
      "id": "checksecret01",
      "name": "Проверка секрета",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "sec1",
              "leftValue": "={{ $json.headers['x-cf-secret'] }}",
              "rightValue": "={{ $env.CF_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "extractid01",
      "name": "Извлечь row_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst rowId = (b.data && (b.data.Id ?? b.data.id)) ?? b.rowId ?? b.row_id ?? b.id;\nreturn [{ json: { row_id: Number(rowId) } }];"
      }
    },
    {
      "id": "getrow01",
      "name": "NocoDB: получить ролик",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.NOCODB_URL }}/api/v2/tables/{{ $env.NOCODB_TABLE_ID }}/records/{{ $json.row_id }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "xc-token",
              "value": "={{ $env.NOCODB_TOKEN }}"
            }
          ]
        }
      }
    },
    {
      "id": "guard01",
      "name": "Ещё не обработано? (защита от дублей)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "g1",
              "leftValue": "={{ $json['Одобрено владельцем'] }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "g2",
              "leftValue": "={{ $json['Статус'] }}",
              "rightValue": "На согласовании",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "markapproved01",
      "name": "NocoDB: статус = Одобрено",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.NOCODB_URL }}/api/v2/tables/{{ $env.NOCODB_TABLE_ID }}/records",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "xc-token",
              "value": "={{ $env.NOCODB_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([{ Id: $json.Id, 'Статус': 'Одобрено', 'Решение': 'Одобрено владельцем в NocoDB · ' + $now.setZone('Europe/Moscow').toFormat('dd.MM.yyyy HH:mm') }]) }}"
      }
    },
    {
      "id": "chantg01",
      "name": "Канал включает Telegram?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "ch1",
              "leftValue": "={{ $('NocoDB: получить ролик').item.json['Канал'] }}",
              "rightValue": "Telegram",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "tgpublish01",
      "name": "Telegram: публикация в канале",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TG_BOT_TOKEN }}/sendVideo",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const r = $('NocoDB: получить ролик').item.json; const caption = '<b>' + (r['Название'] || '') + '</b>' + (r['Хук'] ? ('\\n\\n' + r['Хук']) : ''); const capFinal = caption.length > 1024 ? caption.slice(0, 1020) + '…' : caption; return JSON.stringify({ chat_id: -1003914664264, video: r['video_url'], parse_mode: 'HTML', caption: capFinal, supports_streaming: true }); })() }}"
      }
    },
    {
      "id": "marktgpublished01",
      "name": "NocoDB: статус = Опубликовано (TG)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        -80
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.NOCODB_URL }}/api/v2/tables/{{ $env.NOCODB_TABLE_ID }}/records",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "xc-token",
              "value": "={{ $env.NOCODB_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([{ Id: $('NocoDB: получить ролик').item.json.Id, 'Статус': 'Опубликовано', 'Дата публикации': $now.setZone('Europe/Moscow').toFormat('yyyy-MM-dd'), 'TG message id': String($json.result?.message_id ?? '') }]) }}"
      }
    },
    {
      "id": "ok01",
      "name": "OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true}",
        "options": {}
      }
    },
    {
      "id": "err403",
      "name": "403",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        220,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"error\":\"forbidden\"}",
        "options": {
          "responseCode": 403
        }
      }
    },
    {
      "id": "skipresp01",
      "name": "OK (пропущено)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        880,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true,\"skipped\":true}",
        "options": {}
      }
    }
  ],
