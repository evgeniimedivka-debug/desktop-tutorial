{
  "name": "CF-09 Публикация в Instagram по одобрению (NocoDB)",
  "nodes": [
    {
      "id": "webhook01",
      "name": "Webhook: NocoDB approve (IG)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "cf/publish-instagram",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "9e21ecde-3eed-4327-ba52-5883dd036521"
    },
    {
      "id": "checksecret01",
      "name": "Проверка секрета",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "sec1",
              "leftValue": "={{ $json.headers['x-cf-secret'] }}",
              "rightValue": "={{ $env.CF_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "extractid01",
      "name": "Извлечь row_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst rowId = (b.data && (b.data.Id ?? b.data.id)) ?? b.rowId ?? b.row_id ?? b.id;\nreturn [{ json: { row_id: Number(rowId) } }];"
      }
    },
    {
      "id": "getrow01",
      "name": "NocoDB: получить ролик",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.NOCODB_URL }}/api/v2/tables/{{ $env.NOCODB_TABLE_ID }}/records/{{ $json.row_id }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "xc-token",
              "value": "={{ $env.NOCODB_TOKEN }}"
            }
          ]
        }
      }
    },
    {
      "id": "guard01",
      "name": "Нужна ли IG-публикация? (защита от дублей)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "g1",
              "leftValue": "={{ $json['Одобрено владельцем'] }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "g2",
              "leftValue": "={{ $json['IG: Опубликовано'] }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "g3",
              "leftValue": "={{ $json['Канал'] }}",
              "rightValue": "Instagram",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "igcreate01",
      "name": "IG: создать контейнер (Reels)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.instagram.com/v21.0/{{ $env.IG_USER_ID }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "media_type",
              "value": "REELS"
            },
            {
              "name": "video_url",
              "value": "={{ $('NocoDB: получить ролик').item.json.video_url }}"
            },
            {
              "name": "caption",
              "value": "={{ $('NocoDB: получить ролик').item.json['Подпись_для_канала'] || $('NocoDB: получить ролик').item.json['Название'] || '' }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.IG_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "wait01",
      "name": "Подождать обработку",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      },
      "webhookId": "c0d5572f-6e82-46dc-8717-70f43e820bf4"
    },
    {
      "id": "igcheck01",
      "name": "IG: проверить статус контейнера",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://graph.instagram.com/v21.0/{{ $json.id }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "status_code"
            },
            {
              "name": "access_token",
              "value": "={{ $env.IG_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "finished01",
      "name": "FINISHED? (иначе снова ждать)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ $json.status_code }}",
              "rightValue": "FINISHED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "igpublish01",
      "name": "IG: media_publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.instagram.com/v21.0/{{ $env.IG_USER_ID }}/media_publish",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{ $('IG: создать контейнер (Reels)').item.json.id }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.IG_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "marked01",
      "name": "NocoDB: IG опубликовано = true",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        -80
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.NOCODB_URL }}/api/v2/tables/{{ $env.NOCODB_TABLE_ID }}/records",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "xc-token",
              "value": "={{ $env.NOCODB_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([{ Id: $('NocoDB: получить ролик').item.json.Id, 'IG: Опубликовано': true, 'IG media id': String($json.id ?? ''), 'Дата публикации': $now.setZone('Europe/Moscow').toFormat('yyyy-MM-dd') }]) }}"
      }
    },
    {
      "id": "ok01",
      "name": "OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        2420,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true}",
        "options": {}
      }
    },
    {
      "id": "err403",
      "name": "403",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        220,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"error\":\"forbidden\"}",
        "options": {
          "responseCode": 403
        }
      }
    },
    {
      "id": "skip01",
      "name": "OK (пропущено)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [
        880,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true,\"skipped\":true}",
        "options": {}
      }
    }
  ],
